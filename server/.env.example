# Feedants Competition API Server Environment Configuration

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# MongoDB Connection String (leave empty to use embedded in-memory MongoDB)
MONGODB_URI=mongodb://localhost:27017/feedants_competition

# Razorpay Test Configuration (Safe mock abstraction)
RAZORPAY_KEY_ID=rzp_test_mockKeyId12345
RAZORPAY_KEY_SECRET=rzp_test_mockKeySecret67890
